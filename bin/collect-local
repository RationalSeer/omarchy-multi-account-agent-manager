#!/usr/bin/env python3
"""Estimate usage for a CLI that has no stock Omarchy collector.

Scans the session directories named in the tool definition (`localUsage.dirs`)
for JSON / JSONL files, counts sessions and user prompts per day, and sums any
token-usage objects it recognises. Prints one record in the same contract the
stock collectors use, so the Agents panel can show it; `usageStatusText` says
it is an estimate. No network, no credentials.
"""
import argparse, datetime as dt, glob, json, os, sqlite3, sys

TOKEN_KEYS = {
  "inputTokens": ("input_tokens", "prompt_tokens", "inputTokens", "promptTokens"),
  "outputTokens": ("output_tokens", "completion_tokens", "outputTokens", "completionTokens"),
  "cacheReadInputTokens": ("cache_read_input_tokens", "cacheReadInputTokens", "cached_tokens", "cacheRead"),
  "cacheCreationInputTokens": ("cache_creation_input_tokens", "cacheCreationInputTokens", "cacheWrite"),
}
USER_ROLES = ("user", "human")
MAX_AGE_DAYS = 90
MAX_FILE_BYTES = 64 * 1024 * 1024


def expand(p, home):
  return os.path.expanduser(p.replace("~", home, 1) if p.startswith("~") else p)


def walk(obj, found):
  """Collect (model, usage-dict) pairs from any nesting level."""
  if isinstance(obj, dict):
    keys = set(obj)
    if any(k in keys for ks in TOKEN_KEYS.values() for k in ks):
      found.append((obj.get("model") if isinstance(obj.get("model"), str) else None, obj))
    for v in obj.values():
      walk(v, found)
  elif isinstance(obj, list):
    for v in obj:
      walk(v, found)


def is_user_turn(obj):
  if not isinstance(obj, dict):
    return False
  for key in ("role", "type", "sender"):
    if str(obj.get(key, "")).lower() in USER_ROLES:
      return True
  msg = obj.get("message")
  return isinstance(msg, dict) and str(msg.get("role", "")).lower() in USER_ROLES


def records_in(path):
  if os.path.getsize(path) > MAX_FILE_BYTES:
    return []
  with open(path, encoding="utf-8", errors="replace") as fh:
    text = fh.read()
  if path.endswith(".jsonl"):
    out = []
    for line in text.splitlines():
      line = line.strip()
      if line.startswith("{"):
        try:
          out.append(json.loads(line))
        except ValueError:
          pass
    return out
  try:
    data = json.loads(text)
  except ValueError:
    return []
  if isinstance(data, list):
    return data
  if isinstance(data, dict):
    for key in ("messages", "turns", "history", "events", "items"):
      if isinstance(data.get(key), list):
        return [data] + data[key]
    return [data]
  return []


def main():
  ap = argparse.ArgumentParser()
  ap.add_argument("--tool", required=True)
  ap.add_argument("--dir", required=True, help="profile directory")
  ap.add_argument("--def", dest="definition", required=True, help="tool definition JSON file")
  args = ap.parse_args()
  home = os.path.expanduser("~")
  with open(args.definition, encoding="utf-8") as fh:
    tool = json.load(fh)
  local = tool.get("localUsage") or {}
  default_dir = expand(tool.get("defaultDir") or "", home)
  profile_dir = expand(args.dir, home)
  dirs = []
  for d in local.get("dirs") or []:
    d = expand(d, home)
    # env-mode tools keep sessions inside the profile directory; follow it
    if default_dir and d.startswith(default_dir) and profile_dir != default_dir:
      d = profile_dir + d[len(default_dir):]
    dirs.append(d)
  if not dirs:
    return 0
  globs = local.get("globs") or ["**/*.jsonl", "**/*.json"]

  today = dt.date.today()
  cutoff = (dt.datetime.now() - dt.timedelta(days=MAX_AGE_DAYS)).timestamp()
  per_day = {}     # date -> {"sessions", "prompts", "tokens"}
  model_usage = {}
  today_models = {}
  seen_models = False

  for d in dirs:
    if not os.path.isdir(d):
      continue
    paths = set()
    for pattern in globs:
      paths.update(glob.glob(os.path.join(d, pattern), recursive=True))
    for path in sorted(paths):
      if not (path.endswith(".json") or path.endswith(".jsonl")) or not os.path.isfile(path):
        continue
      try:
        mtime = os.path.getmtime(path)
      except OSError:
        continue
      if mtime < cutoff:
        continue
      day = dt.date.fromtimestamp(mtime)
      entries = records_in(path)
      if not entries:
        continue
      bucket = per_day.setdefault(day, {"sessions": 0, "prompts": 0, "tokens": 0})
      bucket["sessions"] += 1
      found = []
      for e in entries:
        if is_user_turn(e):
          bucket["prompts"] += 1
        walk(e, found)
      for model, usage in found:
        model = model or "unknown"
        seen_models = True
        acc = model_usage.setdefault(model, {k: 0 for k in TOKEN_KEYS})
        total = 0
        for out_key, in_keys in TOKEN_KEYS.items():
          v = next((usage[k] for k in in_keys if isinstance(usage.get(k), (int, float))), 0)
          acc[out_key] += int(v)
          total += int(v)
        bucket["tokens"] += total
        if day == today:
          today_models[model] = today_models.get(model, 0) + total

  # session indexes (sqlite): one row per session, dated by a time column in s or ms
  for spec in local.get("sqlite") or []:
    path = expand(spec.get("path") or "", home)
    if default_dir and path.startswith(default_dir) and profile_dir != default_dir:
      path = profile_dir + path[len(default_dir):]
    table, col = spec.get("table"), spec.get("timeColumn")
    if not (os.path.isfile(path) and table and col):
      continue
    try:
      con = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
      rows = con.execute('SELECT "%s" FROM "%s"' % (col.replace('"', ''), table.replace('"', ''))).fetchall()
      con.close()
    except sqlite3.Error:
      continue
    for (ts,) in rows:
      try:
        ts = float(ts)
      except (TypeError, ValueError):
        continue
      if ts > 1e12:
        ts /= 1000.0
      if ts < cutoff:
        continue
      bucket = per_day.setdefault(dt.date.fromtimestamp(ts), {"sessions": 0, "prompts": 0, "tokens": 0})
      bucket["sessions"] += 1

  # a record with no prompts, tokens or indexed sessions is noise (a stray
  # config file, say); print nothing so the panels show nothing
  if not per_day or not any(b["prompts"] or b["tokens"] or b["sessions"] for b in per_day.values()):
    return 0
  if not any(b["prompts"] or b["tokens"] for b in per_day.values()) and not (local.get("sqlite")):
    return 0
  days = sorted(per_day)
  recent = []
  for i in range(6, -1, -1):
    d = today - dt.timedelta(days=i)
    recent.append({"date": d.isoformat(), "messageCount": per_day.get(d, {}).get("tokens", 0), "promptCount": per_day.get(d, {}).get("prompts", 0), "sessionCount": per_day.get(d, {}).get("sessions", 0)})
  t = per_day.get(today, {"sessions": 0, "prompts": 0, "tokens": 0})
  record = {
    "schemaVersion": 1,
    "id": args.tool,
    "name": tool.get("name") or args.tool,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": True,
    "hasLocalStats": True,
    "tierLabel": "",
    "usageStatusText": local.get("note") or "Estimated from local session files.",
    "authHelpText": "",
    "limits": [],
    "estimated": True,
    "totalPrompts": sum(b["prompts"] for b in per_day.values()),
    "totalSessions": sum(b["sessions"] for b in per_day.values()),
    "activeDays": len(days),
    "activeDates": [d.isoformat() for d in days],
    "recentDays": recent,
    "todayPrompts": t["prompts"],
    "todaySessions": t["sessions"],
    "todayTotalTokens": t["tokens"],
    "todayTokensByModel": today_models,
    "modelUsage": model_usage if seen_models else {},
  }
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  sys.exit(main())
